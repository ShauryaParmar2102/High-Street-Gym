<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>High Street Gym - Weekly Class Timetable
</title>

  <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-50">

  <%- include("partials/admin-navbar.ejs") %>

  <main class="max-w-6xl mx-auto px-4 py-10">

    <!-- PAGE HEADING -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800 text-center">
            Weekly Class Timetable
      </h1>

      <p class="text-gray-600 mt-2 text-center">
        Browse available High Street Gym Sessions and book a class 
      </p>
    </div>

   

    <!-- YOUR SESSION CODE STARTS HERE -->


  <% const days = Object.keys(sessionByDay); %>

  <% days.forEach((day) => { %>

    <!-- Day section -->
    <section class="bg-white border border-hsg-border rounded-xl p-6 mb-6">

      <h2 class="timetable-day-heading text-xl md:text-2xl font-bold mb-4 text-hsg-purple bg-hsg-background text-center">
        <%= day %>
      </h2>


      <% if (sessionByDay[day].length === 0) { %>

        <p class="text-gray-500">
          There are no sessions available for this day.
        </p>


      <% } else { %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

          <% sessionByDay[day].forEach((session) => { %>

            

            <div class="border border-gray-200 rounded-xl p-5 bg-white shadow-sm"
     style="padding: 20px; margin: 0 16px 16px;">

              <!-- Session heading -->
              <h3 class="text-xl font-bold text-gray-800">
                <%= session.activity_name %>
              </h3>


              <!-- Session details -->
              <div class="mt-4 space-y-2 text-gray-600">

                <p>
                  <span class="font-semibold text-gray-800">
                    Location:
                  </span>

                  <%= session.location_name %>
                </p>

                <p>
                  <span class="font-semibold text-gray-800">
                    Trainer:
                  </span>

                  <%= session.trainer_name %>
                </p>

                <p>
                  <span class="font-semibold text-gray-800">
                    Time:
                  </span>

                  <%= session.start_time %> - <%= session.end_time %>
                </p>

                <p>
                  <span class="font-semibold text-gray-800">
                    Date:
                  </span>

                  <%= session.date %>
                </p>

              </div>

              <%
                // Get today's date
                const today = new Date();

                // Check if the session date has already passed
                today.setHours(0, 0, 0, 0);

                // Set today's time to midnight so only the date is compared
                const sessionDate = new Date(session.date);

                  // Set the session time to midnight so only the date is compared
                sessionDate.setHours(0, 0, 0, 0);

                // Check if the session date is before today's date
                const isPast = sessionDate < today; 
              %>


              <!-- Session action -->
              <div class="mt-6">

               <% if (session.isBooked) { %>

  <div class="bg-green-50 border border-green-200 rounded-lg p-3"
     style="padding: 16px;">

    <span class="text-green-700 font-semibold">
      ✓ Session Booked
    </span>

    <p class="text-sm text-gray-600 mt-1">
      Manage or cancel this booking from My Bookings.
    </p>

  </div>


                <% } else if (isPast) { %>

                  <button
                    type="button"
                    disabled
                    class="w-full bg-gray-500 text-white py-3 rounded-xl text-center"
                    
                    >

                    Session Unavailable
                  </button>


                <% } else { %>

                  <a
                    href="/booking/member/confirm/<%= session.session_id %>"
                    class="block w-full text-center bg-anytime-purple text-white py-3 rounded-xl font-semibold"
                  >
                    Book Session
                  </a>

                <% } %>

              </div>

            </div>

          <% }) %>

        </div>

      <% } %>

    </section>

  <% }) %>

</main>

</body>
</html>
