<!DOCTYPE html>
<html>

<head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Session Management</title>
</head>

<body class="bg-gray-50 text-gray-900">

    <%- include("partials/admin-navbar.ejs", { user: user }) %>


<main class="max-w-5xl mx-auto px-6 sm:px-8 py-6">

    <!-- HEADER -->
    <h1 class="text-3xl font-bold mb-2 text-center">
        Session Management
    </h1>

    <p class="text-gray-600 mb-6 text-center">
        Create, edit, and manage scheduled gym sessions.
    </p>

     <!-- ================= CREATE / EDIT SESSION ================= -->
        <div id="edit-session" class="crud-form mb-8 bg-white border border-gray-200 shadow-sm rounded-xl p-6">
        

            <% const isEdit = selectedSession?.session?.id; %>

            <h2 class="text-xl font-bold mb-4 text-center">
                <%= isEdit ? "Edit Session" : "Create Session" %>
            </h2>


            <!-- Send session information to the Session Controller -->
            <form
                action="<%= isEdit ? '/session/' + selectedSession.session.id : '/session' %>"
                method="post"
                class="space-y-4 w-full max-w-xl mx-auto px-4 sm:px-6"
            >

                <!-- Trainer -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Trainer
                    </label>

                    <select
                        name="trainerId"
                        required
                        class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                    >

                        <option value="">
                            Select Trainer
                        </option>

                        <% for (const trainer of users) { %>

                            <option
                                value="<%= trainer.id %>"
                                <%= selectedSession?.session?.trainerId == trainer.id
                                    ? "selected"
                                    : "" %>
                            >
                                <%= trainer.firstName %> <%= trainer.lastName %>
                            </option>

                        <% } %>

                    </select>

                </div>


                <!-- Activity -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Activity
                    </label>

                    <select
                        name="activityId"
                        required
                        class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                    >

                        <option value="">
                            Select Activity
                        </option>

                        <% for (const activity of activities) { %>

                            <option
                                value="<%= activity.id %>"
                                <%= selectedSession?.session?.activityId == activity.id
                                    ? "selected"
                                    : "" %>
                            >
                                <%= activity.name %>
                            </option>

                        <% } %>

                    </select>

                </div>


                <!-- Location -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Location
                    </label>

                    <select
                        name="locationId"
                        required
                        class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                    >

                        <option value="">
                            Select Location
                        </option>

                        <% for (const location of locations) { %>

                            <option
                                value="<%= location.id %>"
                                <%= selectedSession?.session?.locationId == location.id
                                    ? "selected"
                                    : "" %>
                            >
                                <%= location.name %>
                            </option>

                        <% } %>

                    </select>

                </div>


                <!-- Session Date -->
                <div>

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Session Date
                    </label>

                    <input
                        type="date"
                        name="sessionDate"
                        required
                        value="<%= selectedSession?.session?.sessionDate
                            ? (() => {
                                const d = new Date(selectedSession.session.sessionDate);
                                return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                            })()
                            : '' %>"
                        class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                    >
                </div>


                <!-- Start and End Time -->
                <div class="grid grid-cols-2 gap-4">

                    <div>

                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Start Time
                        </label>

                        <input
                            type="time"
                            name="startTime"
                            required
                            value="<%= selectedSession?.session?.startTime || '' %>"
                            class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                        >

                    </div>


                    <div>

                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            End Time
                        </label>

                        <input
                            type="time"
                            name="endTime"
                            required
                            value="<%= selectedSession?.session?.endTime || '' %>"
                            class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                        >

                    </div>

                </div>


                <!-- Capacity -->
                <div class="mb-4">

                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Capacity
                    </label>

                    <input
                        type="number"
                        name="capacity"
                        min="1"
                        required
                        value="<%= selectedSession?.session?.capacity || '' %>"
                        class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none"
                    >

                </div>

<!-- Buttons -->
<div class="flex justify-center gap-4 mt-6 mb-4">

    <% if (!isEdit) { %>

        <!-- Create a new session -->
        <button
            type="submit"
            name="action"
            value="create"
            class="bg-hsg-purple text-white px-4 py-3 rounded-xl font-semibold"
        >
            Create
        </button>

    <% } else { %>

        <!-- Update the selected session -->
        <button
            type="submit"
            name="action"
            value="update"
            class="bg-hsg-purple text-white px-4 py-3 rounded-xl font-semibold"
        >
            Update
        </button>

        <!-- Delete the selected session -->
        <button
            type="submit"
            name="action"
            value="delete"
            class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold"
        >
            Delete
        </button>

    <% } %>

    <!-- Clear the form -->
    <button
        type="reset"
        class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold"
    >
        Clear
    </button>

</div>


                

                    

            </form>

        </div>

    </section>

</main>

<%- include("partials/footer.ejs") %>


</body>
</html>
 


    <!-- SESSION MANAGEMENT GRID -->
    <section class="grid grid-cols-1 gap-6 max-w-6xl mx-auto px-4 sm:px-6">

        <!-- ================= SESSION LIST ================= -->
        <div id="session-list" class="bg-white border border-gray-200 shadow-sm rounded-xl p-5 w-full max-w-6xl mx-auto">

            <h2 class="text-xl font-bold mb-4 text-center">
                Scheduled Sessions
            </h2>


            
<!-- Search and filter the scheduled sessions -->
<form
    method="GET"
    action="/session#session-list"
    class="session-filter-form mb-5"
>

    <!-- Search -->
    <input
        type="text"
        name="search"
        placeholder="Search trainer, activity or location..."
        value="<%= search || '' %>"
        class="border border-gray-300 px-4 py-3 rounded-xl"
    >

    <!-- Date -->
    <input
        type="date"
        name="date"
        value="<%= date || '' %>"
        class="border border-gray-300 px-4 py-3 rounded-xl"
    >

    <!-- Capacity -->
    <input
        type="number"
        name="capacity"
        placeholder="Capacity"
        value="<%= capacity || '' %>"
        class="border border-gray-300 px-4 py-3 rounded-xl"
    >

    <!-- Start Time -->
    <input
        type="time"
        name="start_time"
        value="<%= start_time || '' %>"
        aria-label="Start time"
        class="border border-gray-300 px-4 py-3 rounded-xl"
    >

    <!-- End Time -->
    <input
        type="time"
        name="end_time"
        value="<%= end_time || '' %>"
        aria-label="End time"
        class="border border-gray-300 px-4 py-3 rounded-xl"
    >

    <!-- Search button -->
    <button
        type="submit"
        class="bg-hsg-purple text-white px-4 py-3 rounded-xl font-semibold"
    >
        Search
    </button>

    <!-- Clear filters -->
    <a
        href="/session#session-list"
        class="bg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold"
    >
        Clear
    </a>

</form>

    </div>
</form>



            <!-- Display all scheduled sessions -->
            <% if (sessions && sessions.length) { %>

                <div class="w-full overflow-x-auto px-4 sm:px-6">
                <div class="session-table-inner min-w-[800px]">

                    <!-- Session grid headings -->
        <div class="session-table-header">
                        <span>Activity</span>
                        <span>Trainer</span>
                        <span>Location</span>
                        <span>Date</span>
                        <span>Capacity</span>
                        <span>Time</span>
                        <span class="text-center">Actions</span>
                    </div>

                 
<% for (const s of sessions) { %>

    <div class="session-row">

        <!-- Activity -->
        <div class="font-medium break-words">
            <%= s.activity?.name || "Activity" %>
        </div>

        <!-- Trainer -->
        <div class="break-words">
            <span class="session-mobile-label">Trainer: </span>
            <%= s.user?.firstName || "" %>
            <%= s.user?.lastName || "" %>
        </div>

        <!-- Location -->
        <div class="break-words">
            <span class="session-mobile-label">Location: </span>
            <%= s.location?.name || "" %>
        </div>

        <!-- Date -->
        <div>

             <span class="session-mobile-label">Date: </span>

            <%= s.session?.sessionDate
                ? new Date(s.session.sessionDate).toLocaleDateString("en-AU")
                : "" %>
        </div>

        <!-- Capacity -->
        <div>
            <span class="session-mobile-label">Capacity: </span>
            <%= s.session?.capacity || "" %>
        </div>

        <!-- Time -->
        <div>
            <span class="session-mobile-label">Time: </span>
            <%= s.session?.startTime || s.session?.start_time || "" %>
            –
            <%= s.session?.endTime || s.session?.end_time || "" %>
        </div>

        
        <!-- Actions -->
       
<div class="session-actions" style="text-align: center;">

    <a
        href="/session?edit_id=<%= s.session.id %>#edit-session"
        class="inline-block px-4 py-2 bg-hsg-purple text-white text-sm font-medium rounded-xl hover:opacity-90 shadow-sm transition">
        Edit
    </a>
</div>

    </div>

<% } %> <!-- Closes the sessions loop -->

</div> <!-- Closes min-width grid -->
</div> <!-- Closes overflow container -->

<% } else { %>

    <p class="text-gray-500">
        No sessions found.
    </p>

<% } %>


        </div>


       