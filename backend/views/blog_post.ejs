<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("partials/head.ejs") %>
  <title>Community Blog - High Street Gym</title>
</head>

<body style="margin: 0; padding: 0;" class="bg-hsg-background min-h-screen text-hsg-text">

  <main class="max-w-5xl mx-auto p-6">

    <!-- Community blog heading -->
    <div class="mb-8">

      <h1 class="text-3xl font-bold text-gray-900 text-center">
        Community Blog
      </h1>

      <p class="text-gray-900 mt-1 text-center">
        View posts shared by High Street Gym members.
      </p>

<!-- Return to the login page -->

<!-- Return to the login page -->
<div class="flex justify-center">
  
<a
  href="/authenticate"
  class="inline-flex items-center justify-center min-w-48 mt-4 px-6 py-3
     bg-hsg-purple text-white
     rounded-xl font-semibold
     hover:opacity-90 transition whitespace-nowrap"
>
  ← Back to Login
</a>
     </div>
  </div>


    <!-- Blog posts -->
    <% if (posts && posts.length > 0) { %>

        <!-- Community Posts heading -->
        <div class="bg-gray-100 border border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-700"
            style="background-color: #f3f4f6; margin: 24px 16px 20px; padding: 16px;">
          Community Posts
        </div>

      <div class="space-y-4" style="padding: 0 16px;">

        <% posts.forEach((post) => { %>

          <!-- Display one community post -->
          <article class="bg-white border border-gray-200 rounded-xl p-5 mb-4 shadow-sm"
         style="padding: 20px; margin-bottom: 16px;">

            <!-- Post author -->
            <p class="text-sm text-gray-500 mt-1">
              Posted by
              <span class="font-semibold text-gray-700">
                <%= post.firstName %> <%= post.lastName %>
              </span>
            </p>
            
            <!-- Grey divider -->
<hr class="border-t border-gray-200 my-3">

            <!-- Post title -->
            <h2 class="text-2xl font-bold text-gray-900 wrap-break-words">
              <%= post.title %>
            </h2>

            

          

            <!-- Post content -->
            <p class="text-gray-700 leading-relaxed whitespace-pre-line wrap-break-words">
              <%= post.content %>
            </p>
          </article>

        <% }) %>

      </div>

    <% } else { %>

      <!-- Message shown when there are no posts -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">

        <p class="text-gray-500">
          No community posts have been shared yet.
        </p>

      </div>

    <% } %>

  </main>

  <%- include("partials/footer.ejs") %>

</body>

</html>
