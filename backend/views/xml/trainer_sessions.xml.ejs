<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE trainerSchedule [
    <!ELEMENT trainerSchedule (trainer, week, sessions)>
    <!ELEMENT trainer (#PCDATA | name)*>
    <!ELEMENT name (#PCDATA)>

    <!ELEMENT week (startDate, endDate)>
    <!ELEMENT startDate (#PCDATA)>
    <!ELEMENT endDate (#PCDATA)>

    <!ELEMENT sessions (session*)>
    <!ELEMENT session (activity, trainer, location, date, startTime, endTime)>
    <!ATTLIST session id CDATA #REQUIRED>

    <!ELEMENT activity (#PCDATA)>
    <!ELEMENT location (#PCDATA)>
    <!ELEMENT date (#PCDATA)>
    <!ELEMENT startTime (#PCDATA)>
    <!ELEMENT endTime (#PCDATA)>
]>

<trainerSchedule>

    <trainer>
        <name><%= trainer.firstName %> <%= trainer.lastName %></name>
    </trainer>

    <week>
    <startDate><%= new Date(startDate).toLocaleDateString("en-AU") %></startDate>
    <endDate><%= new Date(endDate).toLocaleDateString("en-AU") %></endDate>
</week>

    <sessions>

        <% sessions.forEach((item) => { %>

            <session id="<%= item.session.id %>">
    <activity><%= item.activity.name %></activity>
                <trainer><%= item.user.firstName %> <%= item.user.lastName %></trainer>
                <location><%= item.location.name %></location>
                <date><%= new Date(item.session.sessionDate).toLocaleDateString("en-AU") %></date>
                <startTime><%= item.session.startTime %></startTime>
                <endTime><%= item.session.endTime %></endTime>
            </session>

        <% }) %>

    </sessions>

</trainerSchedule>