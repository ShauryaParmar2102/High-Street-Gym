<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
<link rel="stylesheet" href="/css/tailwind.css">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title>High Street Gym - Sign Up</title>


</head>

<body class="bg-white min-h-screen">
    <main class="min-h-screen flex flex-col">

        <!-- Registration section -->
        <section class="w-full flex items-center justify-center px-4 py-12">
            <div class="w-full max-w-lg mx-auto">

                <!-- Registration card -->
                <div class="bg-gray rounded-xl shadow-xl border border-gray-200 p-8 md:p-10 max-w-lg mx-auto">
                    
                    <!-- Page heading -->
                    <div class="text-center mb-8">
                        <h1
                            class="text-3xl md:text-4xl font-bold text-black"
                        >
                              Become a Member
                        </h1>

                        <p class="text-gray-600">
                             Create an account to start booking your gym sessions!
                        </p>
                    </div>

                    <!-- Display a registration error when supplied by the controller -->
                    <% if (typeof error !== "undefined" && error) { %>
                        <div
                            class="mb-5 p-4 bg-red-100 border border-red-300 text-red-700 rounded-xl"
                        >
                            <%= error %>
                        </div>
                    <% } %>

                    <!-- Registration form -->
                    <form
                        action="/authenticate/register"
                        method="POST"
                        class="space-y-5"
                    >
                        <!-- First and last name -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                            <!-- First name -->
                            <div>
                                <label
                                    for="firstName"
                                    class="block text-sm font-semibold text-gray-700 mb-2"
                                >
                                    First Name
                                </label>

                                <input
                                    type="text"
                                    name="firstName"
                                    id="firstName"
                                    required
                                    minlength="2"
                                    autocomplete="given-name"
                                    placeholder="Shaurya"
                                    value="<%=
                                        typeof firstName !== 'undefined'
                                            ? firstName
                                            : ''
                                    %>"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-200 focus:border-blue-500 transition"
                                >
                            </div>

                            <!-- Last name -->
                            <div>
                                <label
                                    for="lastName"
                                    class="block text-sm font-semibold text-gray-700 mb-2"
                                >
                                    Last Name
                                </label>

                                <input
                                    type="text"
                                    name="lastName"
                                    id="lastName"
                                    required
                                    minlength="2"
                                    autocomplete="family-name"
                                    placeholder="Parmar"
                                    value="<%=
                                        typeof lastName !== 'undefined'
                                            ? lastName
                                            : ''
                                    %>"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-200 focus:border-blue-500 transition"
                                >
                            </div>
                        </div>

                        <!-- Email address -->
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Email Address
                            </label>

                            <input
                                type="email"
                                name="email"
                                id="email"
                                required
                                autocomplete="email"
                                placeholder="your@email.com"
                                value="<%=
                                    typeof email !== 'undefined'
                                        ? email
                                        : ''
                                %>"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-200 focus:border-blue-500 transition"
                            >
                        </div>

                        <!-- Password -->
                        <div>
                            <label
                                for="password"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Password
                            </label>

                            <input
                                type="password"
                                name="password"
                                id="password"
                                required
                                minlength="8"
                                autocomplete="new-password"
                                placeholder="••••••••"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-white text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-200 focus:border-blue-500 transition"
                            >

                            <p class="text-xs text-gray-500 mt-2">
                                Use at least 8 characters.
                            </p>
                        </div>

                        <!-- Terms agreement -->
                        <div
                            class="p-4 bg-gray-50 rounded-xl border border-gray-100"
                        >
                            <label
                                class="flex items-start gap-3 text-sm text-gray-700"
                            >
                                <input
                                    type="checkbox"
                                    name="termsAccepted"
                                    required
                                    class="w-4 h-4 mt-1 rounded border-gray-300"
                                >

                                <span>
                                    I agree to the Terms of Service and
                                    Privacy Policy.
                                </span>
                            </label>
                        </div>

                        <!-- Submit registration -->
                        <button
                            type="submit"
                            class="inline-block w-full bg-hsg-purple text-white px-5 py-3 rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition"
                        >
                            Register
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="relative my-8">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>

                        <div class="relative flex justify-center text-sm">
                            <span class="px-3 bg-white text-gray-500">
                                Already have an account?
                            </span>
                        </div>
                    </div>

                    <!-- Login link -->
                    <a
                        href="/authenticate"
                        class="w-full block text-center px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition"
                    >
                        Sign In
                    </a>
                </div>
            </div>
        </section>

    </main>
</body>
</html>