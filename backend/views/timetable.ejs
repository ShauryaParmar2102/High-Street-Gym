<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head.ejs") %>
  <title>High Street Gym - Guest Timetable</title>
</head>

<body class="bg-hsg-background min-h-screen overflow-x-hidden text-hsg-text">


  <main class="max-w-6xl mx-auto px-4 py-10">



    <% if (sessionByDay) { %>

      <!-- TIMETABLE SECTION -->
      <section class="mb-12 bg-white border border-hsg-border rounded-xl px-3 py-6 sm:p-6 md:p-8"
         style="padding-bottom: 20px;">

      <h2 class="text-3xl font-bold text-gray-800 text-center">
        Weekly Timetable
      </h2>

        <p class="text-hsg-secondary mb-6 text-center">
          Explore our weekly sessions and log in to book a class.
        </p>

            <!-- Back to Login -->
    <div class="flex justify-center mb-6">

        <a
            href="/authenticate"
              class="inline-flex items-center justify-center min-w-48 px-6 py-3
       bg-hsg-purple text-white rounded-xl font-semibold
       hover:opacity-90 transition whitespace-nowrap"
>
            ← Back to Login
        </a>
    </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
     style="display: grid; row-gap: 32px; column-gap: 24px;">

          <% Object.keys(sessionByDay).forEach(day => { %>

            <!-- DAY -->
            <div class="rounded-2xl bg-white border border-hsg-border p-4 sm:p-5 overflow-hidden"
            style="padding-bottom: 20px;">

              <h3 class="text-xl md:text-2xl font-bold mb-4 text-hsg-purple bg-hsg-background rounded-2xl px-3 py-3 text-center" style="border-radius: 16px;">
                <%= day %>
              </h3>

              <% if (!sessionByDay[day] || sessionByDay[day].length === 0) { %>

                <p class="text-gray-500">
                  No sessions available.
                </p>

              <% } else { %>

                <% sessionByDay[day].forEach(session => { %>

                  <!-- SESSION -->
                  <div class="border border-hsg-border rounded-xl p-4 mb-4 last:mb-0 bg-white">

                    <!-- SESSION TITLE -->
                    <h4 class="text-lg md:text-xl font-bold text-gray-900 break-words">
                      <%= session.activity_name %>
                    </h4>

                    <!-- SESSION DETAILS -->
                    <div class="mt-3 space-y-2 text-sm md:text-base text-gray-700">

                        <p> <%= session.location_name %></p>
                        <p> <%= session.date %></p>
                        <p> <%= session.start_time %> - <%= session.end_time %></p>
                        <p> Trainer: <%= session.trainer_name %></p>
                        <p> Capacity: <%= session.capacity %> people</p>

                    </div>

                    <!-- ACTION -->
                    <div class="mt-5">

                    <% if (session.isExpired === true) { %>

                        <span class="inline-block px-4 py-3 bg-red-100 text-red-700 rounded-xl text-sm font-semibold w-full text-center">
                        ⚠️ Session Expired
                        </span>

                    <% } else { %>

                        <!-- Guest must log in before booking -->
                        <a
                        href="/authenticate"
                        class="inline-block w-full text-center bg-hsg-purple text-white
                        px-5 py-3 rounded-xl font-semibold hover:opacity-90 transition"
                        >
                        Login to Book
                        </a>

                    <% } %>

                    </div>

                  </div>

                <% }) %>

              <% } %>

            </div>

          <% }) %>

        </div>

      </section>

    <% } %>

  </main>

  <%- include("./partials/footer.ejs") %>

</body>

</html>