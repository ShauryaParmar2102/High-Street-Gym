<!DOCTYPE html>
<html>
    <head>
        <%- include("partials/head.ejs") %>
        <title>High Street Gym - Location Management</title>
    </head>

    <body class="bg-gray-50 text-gray-900">

      <%- include("partials/admin-navbar.ejs", { user: authenticatedUser }) %>

        <main class="w-full max-w-5xl mx-auto px-6 sm:px-8 py-6">

            <!-- HEADER -->
  <h1 class="text-3xl font-bold mb-2 text-center">Location Management</h1>
  <p class="text-gray-600 mb-6 text-center">Create, edit, and manage locations</p>

   <!-- Location FORM -->
<div id="edit-location"
     class="crud-form mb-8 bg-white border border-gray-200 shadow-sm rounded-xl p-6">

      <%
        const isEdit = selectedLocation && selectedLocation.id;
      %>

      <h2 class="text-xl font-bold mb-4 text-center">
        <%= isEdit ? "Edit Location" : "Create Location" %>
      </h2>

      <form action="/location/<%= isEdit ? selectedLocation.id : '' %>"
            method="post"
            class="space-y-4 w-full max-w-xl mx-auto px-4 sm:px-6">

               <!-- NAME -->
        <div>
          <label class="block text-sm font-medium text-gray-700">
            Location Name
          </label>

          <input type="text"
                 name="name"
                 required
                 value="<%= selectedLocation ? selectedLocation.name : '' %>"
                 class="w-full mt-1 border border-gray-300 px-4 py-3 rounded-xl bg-white focus:outline-none">
                 
                 <% if (error) { %>
                   <p class="text-red-500 text-sm mt-1">
                     <%= error %>
                   </p>
                 <% } %>
        </div>

         <!-- DESCRIPTION -->
        <div>
          <label class="block text-sm font-medium text-gray-700">
            Location Address
          </label>

          <input type="text"
                 name="address"
                 required
                 value="<%= selectedLocation ? selectedLocation.address : '' %>"
                 class="w-full mt-1 border border-gray-300 p-2.5 rounded-lg
                 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
        </div>


         <!-- BUTTONS -->
        <div class="flex justify-center gap-4 pt-2" style="margin-top: 15px; margin-bottom: 20px;">

         
          <% if (!isEdit) { %>

            <button type="submit" name="action" value="create"
                    class="px-6 py-3 bg-hsg-purple text-white rounded-xl font-semibold">
              Create
            </button>

          <% } else { %>

            <button type="submit" name="action" value="update"
                    class="px-6 py-3 bg-hsg-purple text-white rounded-xl font-semibold">
              Update
            </button>

            <button type="submit"
                  name="action"
                  value="delete"
                  class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition">
            Delete
          </button>

          <% } %>

           <button type="reset"
                  class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition">
            Clear
          </button>



             

        </div>

      </form>

    </div>


   <!-- GRID -->
  <section class="flex flex-col gap-6">

    <!-- ================= LOCATION LIST ================= -->
    <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-4 sm:p-6 overflow-x-auto">

      <h2 class="text-xl font-bold mb-4 text-center">Locations</h2>

    <!-- SEARCH -->
<form method="GET" action="/location"
      class="location-filter-form mb-4">

    <!-- Search locations -->
    <input
        type="text"
        name="search"
        placeholder="Search locations..."
        value="<%= search || '' %>"
        class="border border-gray-300 px-4 py-3 rounded-xl bg-white focus:outline-none"
    >

    <!-- Search button -->
    <button
        type="submit"
        class="px-6 py-3 bg-hsg-purple text-white rounded-xl font-semibold">
        Search
    </button>

    <!-- Clear filters -->
    <a
        href="/location"
        class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition">
        Clear
    </a>

</form>


<div class="location-header px-4 py-3 mx-2 sm:mx-4 bg-gray-100 rounded-lg mb-3 font-semibold text-gray-700">
    <span>Location Name</span>
    <span>Address</span>
    <span>Actions</span>
</div>

        <!-- LIST -->
        <% for (const location of locations) { %>

    <div class="location-row px-4 py-4 mb-3 mx-2 sm:mx-4 bg-white border border-gray-200 rounded-xl shadow-sm hover:bg-gray-50 transition">
            
        <!-- NAME -->
<div class="font-semibold text-gray-900 break-words">
    <%= location.name %>
</div>

<!-- ADDRESS -->
<div class="text-sm text-gray-600 break-words">
    <%= location.address %>
</div>

        <!-- ACTION -->
        <span class="text-right">
            <a href="/location/<%= location.id %>#edit-location"
               class="inline-block px-4 py-3 bg-hsg-purple text-white text-sm font-semibold rounded-xl">
                Edit
            </a>
        </span>

        </div>

    <% } %>

    </div>

    

  </section>

    <%- include("partials/footer.ejs") %>

    </main>

    </body>
    </html>