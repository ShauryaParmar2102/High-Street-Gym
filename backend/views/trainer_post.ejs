<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("./partials/head.ejs") %>
  <title>High Street Gym - Community Microblog</title>
</head>

<body class="bg-gray-50 text-gray-900">
<%- include("partials/admin-navbar.ejs", { user: authenticatedUser }) %>
  <main class="max-w-5xl mx-auto px-4 py-6">

    <!-- HEADER -->
    <div class="mb-8 text-center">

      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Trainer Microblog
      </h1>

      <p class="text-gray-600">
          View and share posts with the High Street Gym community.
      </p>

      <% if (error) { %>
  <div class="mt-4 bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-lg">
    <%= error %>
  </div>
<% } %>

    </div>

      <!-- Open the page where the trainer can create a post -->

      
      
      <div class="w-full flex justify-center">

  <a href="/post/trainer/create"
class="inline-block mt-4 px-6 py-2
          bg-hsg-purple text-white font-semibold
          rounded-xl hover:opacity-90 transition">
    + Create Post
  </a>

  </div>

    <!-- POSTS -->
    <% if (posts && posts.length > 0) { %>

        <!-- GREY HEADING -->
  <div class="bg-gray-100 border border-gray-200 rounded-lg px-4 py-3 font-semibold text-gray-700"
       style="background-color: #f3f4f6; margin: 24px 16px 20px; padding: 16px;">
    Community Posts
  </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6" style="margin-top: 24px; padding: 0 16px;">

        <% posts.forEach((post) => { %>

          <!-- POST CARD -->
          <article
    class="bg-white rounded-xl border border-gray-200
         shadow-sm p-5" style="padding: 20px; margin-bottom: 16px;">

            <!-- AUTHOR -->
            <p class="text-sm font-semibold text-blue-600 mb-2">
              <%= post.firstName || "" %>
              <%= post.lastName || "" %>
            </p>


<!-- DIVIDER BETWEEN AUTHOR AND POST -->
<hr class="border-0 border-t border-gray-200 my-3">

            <!-- TITLE -->
            <h2 class="text-lg font-semibold text-gray-900 wrap-break-word">
              <%= post.title %>
            </h2>

            <!-- CONTENT -->
            <p class="text-gray-600 text-sm mt-3 leading-relaxed wrap-break-word">
              <%= post.content %>
            </p>

            <!-- DATE -->
            <% if (post.createdAt) { %>

              <div class="mt-4 text-xs text-gray-400">

                Posted:
                <%= new Date(post.createdAt).toLocaleDateString("en-AU") %>

              </div>

            <% } %>

            <!-- Only allow the trainer to delete their own post -->
    <% if (
      authenticatedUser &&
      Number(post.userid) === Number(authenticatedUser.id)
    ) { %>

  <form action="/post/trainer" method="post" class="mt-4">

    <input type="hidden" name="action" value="delete">
    <input type="hidden" name="id" value="<%= post.id %>">

    <button
      type="submit"
      class="px-4 py-3 bg-hsg-white text-hsg-purple border border-hsg-purple rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition">
      Delete Post
    </button>

  </form>

<% } %>


          </article>

        <% }) %>

        

      </div>

    <% } else { %>

      <!-- NO POSTS MESSAGE -->
      <div
        class="bg-white rounded-xl border border-gray-200
               shadow-sm p-8 text-center">

        <h2 class="text-xl font-semibold mb-2">
          No Posts Yet
        </h2>

        <p class="text-gray-500">
          No member posts have been shared yet.
        </p>

      </div>

    <% } %>

  </main>

  <%- include("./partials/footer.ejs") %>

</body>

</html>