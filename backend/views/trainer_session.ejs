<!DOCTYPE html>
<html lang="en">

    <head>
        <%- include("partials/head.ejs") %>
        <title>High Street Gym - Manage Trainer Sessions</title>
    </head>

    <body class="bg-gray-50 text-gray-900">
        <%- include("partials/admin-navbar.ejs", { user: user }) %>
    <main class="min-h-screen flex flex-col">

      <div class="flex-1 w-full max-w-none mx-auto px-6 sm:px-8 py-6">

        <!-- HEADER -->
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-900">
                 My Sessions
            </h1>

            <p class="text-gray-600 mt-2">View your upcoming training sessions and class schedule.</p>
        </div>
     


        <!-- CREATE SESSION -->
<div class="crud-form mb-6 bg-white border border-gray-200 rounded-xl shadow-sm p-5">

    <h2 class="text-xl font-bold text-gray-900 text-center mb-5">
        Create Session
    </h2>

    <form action="/session/trainer" method="post"
class="flex flex-col gap-4 w-full max-w-xl mx-auto px-4 sm:px-6">
        

        <input type="hidden" name="action" value="create">

        <!-- Activity -->
        <select name="activity_id" required
        class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl">
            <option value="">Select Activity</option>

            <% activities.forEach((activity) => { %>
                <option value="<%= activity.id %>">
                    <%= activity.name %>
                </option>
            <% }) %>
        </select>

        <!-- Location -->
        <select name="location_id" required
    class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl">
            <option value="">Select Location</option>

            <% locations.forEach((location) => { %>
                <option value="<%= location.id %>">
                    <%= location.name %>
                </option>
            <% }) %>
        </select>

        <input type="date" name="date" required
    class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl">

        <input type="time" name="start_time" required
    class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl">

        <input type="time" name="end_time" required
    class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl">

        <input
            type="number"
            name="capacity"
            min="1"
            placeholder="Capacity"
            required
            class="w-full border border-gray-300 bg-white px-4 py-3 rounded-xl"
        >

    <button
    type="submit"
    style="width: 208px; margin: 0 auto 20px;"
    class="bg-hsg-purple text-white px-6 py-3 rounded-xl font-semibold hover:opacity-90 transition"
>
    Create Session
</button>

    </form>

</div>

<!-- EDIT SESSION -->

<div id="edit-session"
     class="crud-form mb-6 bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    
    <h2 class="text-xl font-bold mb-5 text-gray-900 text-center">
        Edit Session
    </h2>

    <% if (selectedSession) { %>

        <form action="/session/trainer" method="post" class="w-full max-w-xl mx-auto px-4 sm:px-6 box-border">

            <!-- Update action -->
            <input type="hidden" name="action" value="update">

            <!-- Session ID -->
            <input
                type="hidden"
                name="session_id"
                value="<%= selectedSession.session.id %>"
            >

            <!-- Activity -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    Activity
                </label>

                <select
                    name="activity_id"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
                    <% activities.forEach((activity) => { %>
                        <option
                            value="<%= activity.id %>"
                            <%= Number(activity.id) === Number(selectedSession.activity?.id) ? "selected" : "" %>
                        >
                            <%= activity.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Location -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    Location
                </label>

                <select
                    name="location_id"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
                    <% locations.forEach((location) => { %>
                        <option
                            value="<%= location.id %>"
                            <%= Number(location.id) === Number(selectedSession.location?.id) ? "selected" : "" %>
                        >
                            <%= location.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Date -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    Date
                </label>

                <input
                    type="date"
                    name="date"
                    value="<%= selectedSession.session?.date || '' %>"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
            </div>

            <!-- Start Time -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    Start Time
                </label>

                <input
                    type="time"
                    name="start_time"
                    value="<%= selectedSession.session?.start_time || '' %>"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
            </div>

            <!-- End Time -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    End Time
                </label>

                <input
                    type="time"
                    name="end_time"
                    value="<%= selectedSession.session?.end_time || '' %>"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
            </div>

            <!-- Capacity -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-500 mb-1">
                    Capacity
                </label>

                <input
                    type="number"
                    name="capacity"
                    value="<%= selectedSession.session?.capacity || '' %>"
                    min="1"
                    required
                    class="w-full border border-gray-300 rounded-lg p-2"
                >
            </div>

            <!-- Update button -->
            <button
                type="submit"
                class="bg-hsg-purple text-white px-6 py-3 rounded-xl font-semibold block mx-auto mb-6"
            >
                Update Session
            </button>

        </form>

       <% } else { %>

        <p class="text-gray-500 text-center">
            Select a session to edit.
        </p>

    <% } %>

</div>
        
                <!-- XML EXPORT -->
        <div class="w-full max-w-5xl mx-auto mb-6 p-5 rounded-xl shadow-sm bg-white border border-gray-200">

            <h2 class="text-lg font-semibold text-gray-900 mb-4 text-center">

                Export Weekly Sessions
            </h2>

            <form
                method="GET"
                action="/session/trainer/export/xml"
                class="trainer-export-form"
            >

    <!-- Week Start -->
    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
            Week Start
        </label>

        <input
            type="date"
            name="startDate"
            required
            class="w-full border border-gray-300 rounded-xl px-4 py-3 bg-white"
        >
    </div>

    <!-- Week End -->
    <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
            Week End
        </label>

        <input
            type="date"
            name="endDate"
            required
            class="w-full border border-gray-300 rounded-xl px-4 py-3 bg-white"
        >
    </div>

    <!-- Export Button -->
<div class="trainer-export-button">
    <button
        type="submit"
        class="bg-hsg-purple text-white px-4 py-3 rounded-xl font-semibold"
    >
        Export Sessions XML
    </button>
</div>

</form>

</div> <!-- Close XML EXPORT container -->


            <!-- FILTERS -->
        <div class="w-full max-w-none mx-auto mb-6 px-6 py-5 rounded-xl shadow-sm bg-white border border-gray-200">

            <h2 id="session-filters" class="text-lg font-semibold text-gray-900 mb-4 text-center">
                Filter My Sessions
            </h2>

        <form method="GET"
            action="/session/trainer/view#session-filters"
            class="trainer-filters-horizontal px-4 sm:px-6">

        <!-- Activity -->
        <div class="flex flex-col w-full min-w-0">
            <label class="text-sm font-medium text-gray-700 mb-1">
                Activity
            </label>

            <input type="text"
                   name="activity"
                   value="<%= activity || '' %>"
                   placeholder="Search activity..."
                   class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                          focus:outline-none focus:ring-2 focus:ring-blue-500
                          focus:border-blue-500 transition">
        </div>

         <!-- Location -->
                <div class="flex flex-col w-full min-w-0">
                    <label class="text-sm font-medium text-gray-700 mb-1">Location</label>
                    <input type="text" name="location"
                        value="<%= location || '' %>"
                        placeholder="Ashgrove"
                        class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"/>
                </div>

                <!-- Date -->
                <div class="flex flex-col w-full min-w-0">
                    <label class="text-sm font-medium text-gray-700 mb-1">Date</label>
                    <input type="date" name="date"
                        value="<%= date || '' %>"
                        class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"/>
                </div>

                <!-- Start Time -->
                <div class="flex flex-col w-full min-w-0">
                    <label class="text-sm font-medium text-gray-700 mb-1">Start Time</label>
                    <input type="time" name="start_time"
                        value="<%= start_time || '' %>"
                        class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"/>
                </div>

                <!-- End Time -->
                                <div class="flex flex-col w-full min-w-0">

                    <label class="text-sm font-medium text-gray-700 mb-1">End Time</label>
                    <input type="time" name="end_time"
                        value="<%= end_time || '' %>"
                        class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"/>
                </div>

                 <!-- Capacity -->
                                <div class="flex flex-col w-full min-w-0">

                    <label class="text-sm font-medium text-gray-700 mb-1">Capacity</label>
                    <input type="number" name="capacity"
                        value="<%= capacity || '' %>"
                        class="w-full border border-gray-300 p-2.5 rounded-lg bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"/>
                </div>

                <!-- Buttons -->
                 
                <div class="trainer-filter-buttons">
                    
                    <button type="submit"
                        class="bg-hsg-purple text-white px-4 py-3 rounded-xl font-semibold">
                        Search
                    </button>

                    <a href="/session/trainer/view"
                        class="bg-hsg-white text-hsg-purple border border-hsg-purple px-4 py-3 rounded-xl font-semibold hover:bg-hsg-purple hover:text-hsg-white transition"
                        >
                        Clear
                    </a>
                </div>

            </form>

        </div>

          <section class="flex flex-col gap-6">

           
            <!-- TRAINER SESSION INFORMATION -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 md:p-6 text-center">

    <h2 class="text-xl font-bold mb-4 text-gray-900">
        My Session Information
    </h2>

    <p class="text-gray-600 mb-5">
        View the sessions you are scheduled to run.
        Session changes are managed by an administrator.
    </p>

    <% if (sessions && sessions.length > 0) { %>

        <div class="w-full overflow-x-auto">
            <div class="trainer-session-grid">

                  <!-- Column headings -->
                <div class="trainer-session-header">
                    <span>Activity</span>
                    <span>Location</span>
                    <span>Date</span>
                    <span>Time</span>
                    <span>Capacity</span>
                    <span>Actions</span>
                </div>

            <% sessions.forEach((item) => { %>

                <div class="trainer-session-row">

                   
<!-- ACTIVITY -->
<div class="font-semibold break-words">
    <%= item.activity.name %>
</div>

<!-- LOCATION -->
<div>
    <span class="trainer-mobile-label">Location: </span>
    <%= item.location.name %>
</div>

<!-- DATE -->
<div>
    <span class="trainer-mobile-label">Date: </span>
    <%= item.session.date
        ? new Date(item.session.date).toLocaleDateString("en-AU")
        : "" %>
</div>

<!-- TIME -->
<div>
    <span class="trainer-mobile-label">Time: </span>
    <%= item.session.start_time %> -
    <%= item.session.end_time %>
</div>

<!-- CAPACITY -->
<div>
    <span class="trainer-mobile-label">Capacity: </span>
    <%= item.session.capacity %>
</div>

<!-- ACTIONS -->
<div class="trainer-session-actions">

    <!-- EDIT SESSION -->
    <a
        href="/session/trainer/view?edit_id=<%= item.session.id %>#edit-session"
        class="trainer-edit-button">
        Edit
    </a>

    <!-- DELETE SESSION -->
    <form action="/session/trainer" method="post">

        <input type="hidden" name="action" value="delete">

        <input
            type="hidden"
            name="session_id"
            value="<%= item.session.id %>"
        >

        <button type="submit" class="trainer-delete-button">
            Delete
        </button>

    </form>

</div>

</div> <!-- End trainer-session-row -->

<% }) %>

</div> <!-- End trainer-session-grid -->
</div> <!-- End overflow-x-auto -->


<% } else { %>

        <p class="text-gray-500">
            You do not currently have any scheduled sessions.
        </p>

    <% } %>

    </div>


</html>