<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-50 min-h-screen flex flex-col">

    <%- include("partials/admin-navbar.ejs") %>

    <main class="max-w-6xl mx-auto px-4 py-8 w-full grow">

        <!-- WELCOME CARD -->
        <section class="bg-white shadow-lg rounded-2xl p-6 mb-6 text-center">

            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">
                Welcome back, <%= user.firstName %> 👋
            </h1>

            <p class="text-black mt-2 text-base">
                You are logged in as

                <span class="font-semibold capitalize text-hsg-purple">
                    <%= user.role %>
                </span>
            </p>

        </section>


        <!-- ROLE DESCRIPTION -->
        <section class="bg-white rounded-xl p-6 mb-6 text-center border border-gray-200">

            <% if (user.role === "administrator") { %>

                <h2 class="text-xl font-bold text-gray-900 mb-2">
                    Administrator Dashboard
                </h2>

                <p class="text-black">
                    Manage users, posts, sessions, bookings, activities and locations from the admin dashboard.
                </p>

            <% } else if (user.role === "trainer") { %>

                <h2 class="text-xl font-bold text-black mb-2">
                    Trainer Dashboard
                </h2>

                <p class="text-black">
                    Welcome to your trainer dashboard.
                    View your scheduled sessions and manage posts
                    for the High Street Gym community.
                </p>

            <% } else if (user.role === "member") { %>

                <h2 class="text-xl font-bold text-gray-900 mb-2">
                    Member Dashboard
                </h2>

                <p class="text-black">
                    Welcome to High Street Gym.
                    Browse available sessions, manage your bookings
                    and share posts with other members of the gym community.
                </p>

            <% } %>

        </section>


        <!-- DASHBOARD OPTIONS -->
        <section class="bg-white rounded-xl p-6 text-center max-w-5xl mx-auto border border-gray-200">

            <h2 class="text-2xl font-bold text-gray-900 mb-2">
                What You Can Do
            </h2>

            <p class="text-black">
                Use the navigation menu to access the features available
                for your account.
            </p>


            <!-- ADMINISTRATOR -->
            <% if (user.role === "administrator") { %>

                <div class="admin-dashboard-cards mt-6 px-1">

                    <!-- USERS CARD -->
                    <div class="w-full p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            Manage Users
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            View and manage gym user accounts.
                        </p>

                    </div>


                    <!-- GYM CARD -->
                    <div class="w-full p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            Manage Gym
                        </h3>

                        <p class="text-base text-gray-900 mt-3 leading-relaxed dashboard-card-text">
                            Manage sessions, activities and gym locations.
                        </p>

                    </div>


                    <!-- BOOKINGS CARD -->
                    <div class="w-full p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            Bookings & Posts
                        </h3>

                        <p class="text-base text-gray-900 mt-3 leading-relaxed dashboard-card-text">
                            Manage member bookings and community posts.
                        </p>

                    </div>

                </div>


            <!-- TRAINER -->
            <% } else if (user.role === "trainer") { %>

                <div class="trainer-dashboard-cards mt-6 px-6">

                    <!-- SESSIONS CARD -->
                    <div class="w-full md:w-[40%] p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-black text-xl">
                            My Sessions
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            View your upcoming gym sessions and schedule.
                        </p>

                    </div>


                    <!-- MICROBLOG CARD -->
                    <div class="w-full md:w-[40%] p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-black text-xl">
                            Community Microblog
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            View posts shared by members of the gym community.
                        </p>

                    </div>

                </div>


            <!-- MEMBER -->
            <% } else if (user.role === "member") { %>

                <div class="member-dashboard-cards mt-6 px-2">

                    <!-- SESSION CARD -->
                    <div class="w-full md:flex-1 p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card transition hover:-translate-y-1 hover:shadow-lg">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            Find a Session
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            Browse available High Street Gym sessions.
                        </p>

                    </div>

                    <!-- BOOKINGS CARD -->
                    <div class="w-full md:flex-1 p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            My Bookings
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            View and manage your booked sessions.
                        </p>

                    </div>


                    <!-- COMMUNITY CARD -->
                    <div class="w-full md:flex-1 p-6 bg-white border border-gray-200 rounded-2xl text-center shadow-sm dashboard-card">

                        <h3 class="font-semibold text-gray-900 text-xl">
                            Community
                        </h3>

                        <p class="text-base text-black mt-3 leading-relaxed dashboard-card-text">
                            Create and view posts from the gym community.
                        </p>

                    </div>

                </div>

            <% } %>

        </section>


        <!-- FOOTER -->
        <div class="mt-10">
            <%- include("partials/footer.ejs") %>
        </div>

    </main>

</body>

</html>